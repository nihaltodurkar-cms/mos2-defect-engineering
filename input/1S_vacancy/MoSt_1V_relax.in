&CONTROL
    calculation = 'relax',
    restart_mode = 'from_scratch',
    prefix = 'Trial_4',
    outdir = '/home/nihal/Desktop/Otptf/',
    pseudo_dir = '/home/nihal/Desktop/pseudos/',
    verbosity = 'high',
    forc_conv_thr = 1.0d-3
/

&SYSTEM
    ibrav = 0,
    nat = 47,
    ntyp = 2,
    ecutwfc = 65.0,
    ecutrho = 500.0,
    occupations='smearing',
    smearing='fd',
    degauss=0.005,
    nspin = 2,
    starting_magnetization(1) = 0.2,
    starting_magnetization(2) = 0.0
/

&ELECTRONS
    conv_thr = 1.0d-8,
    mixing_beta = 0.3,
    electron_maxstep = 500,
    diagonalization = 'david',
    diago_david_ndim = 12
/

&IONS
    ion_dynamics = 'bfgs'
/

